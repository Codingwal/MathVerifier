define 1:
    1 = Succ(0)
{
    Succ(0) = Succ(0)
}

theorem 1_in_ℕ():
⇒ 1 ∈ ℕ
{
    0 ∈ ℕ                   | @ℕ
    0 ∈ ℕ ⇒ Succ(0) ∈ ℕ     | @ℕ
    1 ∈ ℕ                   | @1
}