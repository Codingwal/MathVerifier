// Definition der natürlichen Zahlen mithilfe der Peano-Axiome
// Da diese Definition ohne ZFC-Mengenlehre auskommen muss, können
// wir die Existenz der natürlichen Zahlen leider nicht beweisen.
// Stattdessen ist sie quasi das Axiom


// Wir definieren 0 als ein beliebiges Objekt. Bei einer Herleitung
// mithilfe der ZFC-Mengenlehre würden wir 0 als ein Synonym für die
// leere Menge definieren
define 0:
{
}

// Succ(n) gibt den Nachfolger von n an. In den Peano-Axiomen wird dieser
// häufig mit n' beschrieben. Bei einer Definition mithilfe der Mengenlehre
// gilt für jede Menge M: Succ(M) = {∅, M}. Daraus folgen auch offensichtlich
// die zwei hier beschriebenen Eigenschaften
define Succ:
    ∀n(∀m(Succ(n) = Succ(m) ⇒ n = m))   // Succ ist induktiv
    ¬∃n(Succ(n) = 0)    // Kein Element wird auf 0 abgebildet (0 ist der "Start der Kette")
{
    sorry
}

// Die zentrale Definition der natürlichen Zahlen (inklusive 0). Die drei
// zentralen Axiome sind hier die Eigenschaften der Menge. Das letzte wird
// auch Induktionsaxiom genannt und ist für die Konstruktion der Menge nicht
// wichtig. Allerdings wird es für fast alle darauf aufbauenden Sätze als
// Teil der Herleitung benötigt (z.B: Beweis der Kommutativität).
define ℕ:
    0 ∈ ℕ   // 0 ist eine natürliche Zahl
    ∀n(n ∈ ℕ ⇒ Succ(n) ∈ ℕ)     // Alle Nachfolger von natürlichen Zahlen sind natürliche Zahlen
    ∀ϕ((ϕ(0) ∧ ∀n(ϕ(n) ⇒ ϕ(Succ(n)))) ⇒ ∀n(ϕ(n))) // Induktionsaxiom
{
    sorry
}

// Wir definieren die Addition rekursiv:
// 1. n + 0 = 0 ("Base case")
// 2. a + b' = (a + b)'
define Add:
    ∀n(n ∈ ℕ ⇒ Add(n, 0) = n)
    ∀a(∀b(a ∈ ℕ ∧ b ∈ ℕ ⇒ Add(a, Succ(b)) = Succ(Add(a, b))))
{
    sorry
}

// Wir definieren die Multiplikation rekursiv:
// 1. 0 ⋅ n = 0
// 2. 1 ⋅ n = n
// 3. k' ⋅ n = n + k ⋅ n
define Mult:
    ∀n(n ∈ ℕ ⇒ Mult(n, 0) = 0)
    ∀n(n ∈ ℕ ⇒ Mult(n, 1) = n)
    ∀k(∀n( k ∈ ℕ ∧ n ∈ ℕ ⇒ Mult(n, Succ(k)) = Add(n, Mult(n, k)) ))
{
    sorry
}

// Wir definieren 1 als Nachfolger von 0.
define 1:
    1 = Succ(0)
{
    Succ(0) = Succ(0)
}

// Wir definieren 2 als Nachfolger von 1.
define 2:
    2 = Succ(1)
{
    Succ(1) = Succ(1)
}

// Beweis, dass 1 eine natürliche Zahl ist. Das folgt einerseits aus der
// Definition von 1 als Nachfolger von 0 und von der zweiten Eigenschaft
// der natürlichen Zahlen.
theorem 1_in_ℕ():
⇒ 1 ∈ ℕ
{
    0 ∈ ℕ                   | @ℕ
    0 ∈ ℕ ⇒ Succ(0) ∈ ℕ     | @ℕ
    1 ∈ ℕ                   | @1
}

// Wir beweisen, dass 1 + 1 = 2 gilt. Dazu verwenden wir
// die Definition der 1 und Defintion der Addition. Außerdem
// ist die Definition der 2 als Nachfolger von 1 wichtig.
theorem Add_1_1_is_2():
⇒ Add(1, 1) = 2
{
    // 0 ist per Definition der natürlichen Zahl eine natürliche Zahl
    0 ∈ ℕ   | @ℕ

    // Das 1 ∈ ℕ gilt, haben wir zuvor schon bewiesen.
    // Diese Eigenschaft ist wichtig, da die Additionsregeln nur für
    // natürliche Zahlen gelten
    1 ∈ ℕ   | 1_in_ℕ()
    
    // Wir zeigen mithilfe der zweiten Eigenschaft der Addition,
    // dass 1 + 1 = (1 + 0)' gilt.
    ∀b(1 ∈ ℕ ∧ b ∈ ℕ ⇒ Add(1, Succ(b)) = Succ(Add(1, b)))   | @Add
    1 ∈ ℕ ∧ 0 ∈ ℕ ⇒ Add(1, Succ(0)) = Succ(Add(1, 0))
    Add(1, 1) = Succ(Add(1, 0))         | @1

    // Aus der ersten Eigenschaft der Addition folgt, dass
    // 1 + 0 = 1 gilt.
    1 ∈ ℕ ⇒ Add(1, 0) = 1   | @Add
    Add(1, 0) = 1

    // Aus 1 + 1 = (1 + 0)' und 1 + 0 = 1 folgt:
    Add(1, 1) = Succ(1)

    // Da 2 als 1' definiert ist, ist die Hypothese damit bewiesen.
    Add(1, 1) = 2           | @2
}
