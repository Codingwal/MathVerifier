#include Examples/DivisionSubtraktion.math

define 2:
    2 = Succ(1)
{
    Succ(1) = Succ(1)
}

theorem 2_in_ℕ():
⇒ 2 ∈ ℕ
{
    1 ∈ ℕ                   | 1_in_ℕ()
    1 ∈ ℕ ⇒ Succ(1) ∈ ℕ     | @ℕ
    2 ∈ ℕ                   | @2
}

theorem Add_1_1_is_2():
⇒ 1 + 1 = 2
{
    0 ∈ ℕ   | @ℕ
    1 ∈ ℕ   | 1_in_ℕ()
    
    // 1 + 1 = Succ(1 + 0)
    ∀b(1 ∈ ℕ ∧ b ∈ ℕ ⇒ 1 + Succ(b) = Succ(1 + b))   | @+
    1 ∈ ℕ ∧ 0 ∈ ℕ ⇒ 1 + Succ(0) = Succ(1 + 0)
    1 + 1 = Succ(1 + 0)         | @1

    // 1 + 0 = 1
    1 ∈ ℕ ⇒ 1 + 0 = 1   | @+
    1 + 0 = 1

    1 + 1 = Succ(1)
    1 + 1 = 2           | @2
}