define ≠(a, b):
    ¬(a = b)

define is_∅(M):
    ∀x(¬(x ∈ M))

define is_0(0):
    is_∅(0)

define is_Succ(s):
    ∀n,m( s(n) = s(m) ⇒ n = m ) \
    ∧ ∀n,z( is_0(z) ⇒ s(n) ≠ z)

define is_ℕ(ℕ):
    ∀z(is_0(z) ⇒ z ∈ ℕ) \
    ∧ ∀n,s(n ∈ ℕ ∧ is_Succ(s) ⇒ s(n) ∈ ℕ) \
    ∧ ∀ϕ(( ∀z(is_0(z) ⇒ ϕ(z)) ∧ ∀n,s( n ∈ ℕ ∧ is_Succ(s) ⇒ (ϕ(n) ⇒ ϕ(s(n))) )) ⇒ ∀n(n ∈ ℕ ⇒ ϕ(n) ))

define is_1(1):
    ∀s,z(is_Succ(s) ∧ is_0(z) ⇒ s(z) = 1)

theorem 1_in_ℕ(0, 1, ℕ, s):
    is_0(0)
    is_1(1)
    is_ℕ(ℕ)
    is_Succ(s)
⇒ 1 ∈ ℕ
{
    0 ∈ ℕ
    0 ∈ ℕ ⇒ s(0) ∈ ℕ
    1 ∈ ℕ
}

