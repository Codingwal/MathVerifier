define is_0(t0):
    p1: true
    ret p1

/*
define Succ:
    ∀n(∀m(Succ(n) = Succ(m) ⇒ n = m))   // Succ ist induktiv
    ∀n(Succ(n) ≠ 0)    // Kein Element wird auf 0 abgebildet (0 ist der "Start der Kette")
{
    sorry
}
*/

// IR1
define is_Succ(t0):
    p1: = t0[.1] t0[.2]            // Succ(n) = Succ(m)
    p2: ⇒ p1[.1, .2] =[.1, .2]    // Succ(n) = Succ(m) ⇒ n = m
    p3: p2[all, all]

    p4: ≠ t0[.1] 0    // Succ(n) ≠ 0
    p5: p4[all]
    
    p6: ∧ p3 p5
    
    ret p6

// IR2
define is_Succ(t0):
    p1: = t0[.1] t0[.2]
    p2: ⇒ p1[.1, .2] =[.1, .2]  // Succ(n) = Succ(m) ⇒ n = m
    p3: p2[all, all]    // ∀n,m: Succ(n) = Succ(m) ⇒ n = m

    p4: .2 t0[.1] .3    // Succ(n) ≠ 0
    p5: p6[all, .1, .2] // ∀n(Succ(n) ≠ 0)
    p6: load is_≠
    p7: load is_0
    p8: ∧ p4[.1] p5[.2] // is_≠(≠) ∧ is_0(0)
    p9: ⇒ p8[.1, .2] p5[.1, .2] // is_≠(≠) ∧ is_0(0) ⇒ ∀n(Succ(n) ≠ 0)
    p10: p9[all, all]   // ∀≠,0: ...

    p11: ∧ p3 p10

    ret p11